<settings:ProviderSettingsViewBase x:Class="PlayniteAchievements.Providers.Local.LocalAchievementSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="clr-namespace:PlayniteAchievements.Providers.Settings"
    xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Providers/ProviderSettingsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <StackPanel Style="{StaticResource ProviderHeaderPanelStyle}">
                <Viewbox Style="{StaticResource ProviderHeaderIconStyle}"><Path Data="{StaticResource GeoReXGlue}" Fill="#16894E"/></Viewbox>
                <TextBlock Text="{DynamicResource LOCPlayAch_Provider_LocalAchievements}" Style="{StaticResource ProviderTitleTextStyle}"/>
            </StackPanel>
            <Border Style="{StaticResource ProviderEnableToggleBorderStyle}">
                <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_ProviderEnabled}" Margin="0">
                    <CheckBox IsChecked="{Binding Settings.IsEnabled, Mode=TwoWay}"/>
                </controls:SettingRow>
            </Border>
            <Border Style="{StaticResource SectionBorderStyle}" IsEnabled="{Binding Settings.IsEnabled}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Local_Introduction}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Local_Game}"/>
                    <ComboBox x:Name="GameBox" DisplayMemberPath="Name" SelectionChanged="Game_Changed" Margin="0,4,0,12"/>
                    <Button Content="{DynamicResource LOCPlayAch_Local_Detect}" Click="Detect_Click" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Local_Format}"/>
                    <ComboBox x:Name="FormatBox" SelectedValuePath="Tag" SelectionChanged="Input_Changed" Margin="0,4,0,12">
                        <ComboBoxItem Tag="" Content="{DynamicResource LOCPlayAch_Local_Auto}"/>
                        <ComboBoxItem Tag="ReXGlue" Content="ReXGlue — TOML"/>
                        <ComboBoxItem Tag="UnleashedRecompiled" Content="Unleashed Recompiled — ACH-DATA"/>
                        <ComboBoxItem Tag="SpartanPort" Content="SpartanPort — trophies.dat"/>
                        <ComboBoxItem Tag="AchievementJson" Content="JSON — Gears of War 2: Hollow"/>
                    </ComboBox>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Local_Progress}"/>
                    <DockPanel Margin="0,4,0,12">
                        <Button DockPanel.Dock="Right" Content="{DynamicResource LOCPlayAch_Button_Browse}" Click="BrowseProgress_Click" Margin="8,0,0,0"/>
                        <TextBox x:Name="ProgressBox" TextChanged="Input_Changed"/>
                    </DockPanel>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Local_Catalog}"/>
                    <DockPanel Margin="0,4,0,12">
                        <Button DockPanel.Dock="Right" Content="{DynamicResource LOCPlayAch_Button_Browse}" Click="BrowseCatalog_Click" Margin="8,0,0,0"/>
                        <TextBox x:Name="CatalogBox" TextChanged="Input_Changed"/>
                    </DockPanel>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Local_Icons}"/>
                    <DockPanel Margin="0,4,0,12">
                        <Button DockPanel.Dock="Right" Content="{DynamicResource LOCPlayAch_Button_Browse}" Click="BrowseIcons_Click" Margin="8,0,0,0"/>
                        <TextBox x:Name="IconsBox" TextChanged="Input_Changed"/>
                    </DockPanel>
                    <controls:SettingRow Label="Title ID" Margin="0,0,0,12"><TextBox x:Name="TitleBox" Width="140" TextChanged="Input_Changed"/></controls:SettingRow>
                    <CheckBox x:Name="ExtrasBox" Content="{DynamicResource LOCPlayAch_Local_Reblue}" Checked="Input_Changed" Unchecked="Input_Changed" Margin="0,0,0,12"/>
                    <CheckBox x:Name="MonitorBox" Content="{DynamicResource LOCPlayAch_Local_Monitor}" IsChecked="True" Checked="Input_Changed" Unchecked="Input_Changed" Margin="0,0,0,12"/>
                    <TextBlock x:Name="CapabilitiesText" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button x:Name="ValidateButton" Content="{DynamicResource LOCPlayAch_Local_Validate}" Click="Validate_Click" Margin="0,0,8,8"/>
                        <Button x:Name="SaveButton" Content="{DynamicResource LOCPlayAch_Local_Save}" Click="Save_Click" IsEnabled="False" Margin="0,0,8,8"/>
                        <Button Content="{DynamicResource LOCPlayAch_Local_Remove}" Click="Remove_Click" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="320" MinHeight="100">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Image Source="{Binding UnlockedIconPath}" Width="32" Height="32"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ID" Binding="{Binding ApiName}" Width="Auto"/>
                            <DataGridTextColumn Header="{DynamicResource LOCPlayAch_Local_Name}" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource LOCPlayAch_Local_Points}" Binding="{Binding Points}" Width="Auto"/>
                            <DataGridCheckBoxColumn Header="{DynamicResource LOCPlayAch_Local_Unlocked}" Binding="{Binding Unlocked}" Width="Auto"/>
                            <DataGridTextColumn Header="{DynamicResource LOCPlayAch_Local_Date}" Binding="{Binding UnlockTimeUtc, StringFormat=G}" Width="Auto"/>
                            <DataGridTextColumn Header="{DynamicResource LOCPlayAch_Common_Description}" Binding="{Binding Description}" Width="240"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SectionBorderStyle}" IsEnabled="{Binding Settings.IsEnabled}">
                <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_UseExophaseForMetadata}" Hint="{DynamicResource LOCPlayAch_Settings_UseExophaseForMetadata_Help}" Margin="0">
                    <CheckBox IsChecked="{Binding Settings.UseExophaseForRarity, Mode=TwoWay}"/>
                </controls:SettingRow>
            </Border>
        </StackPanel>
    </ScrollViewer>
</settings:ProviderSettingsViewBase>
