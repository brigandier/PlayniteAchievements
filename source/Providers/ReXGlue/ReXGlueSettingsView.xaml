<settings:ProviderSettingsViewBase x:Class="PlayniteAchievements.Providers.ReXGlue.ReXGlueSettingsView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:settings="clr-namespace:PlayniteAchievements.Providers.Settings"
            xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Providers/ProviderSettingsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <StackPanel Style="{StaticResource ProviderHeaderPanelStyle}">
                <Viewbox Style="{StaticResource ProviderHeaderIconStyle}">
                    <Path Data="{StaticResource GeoReXGlue}" Fill="#16894E"/>
                </Viewbox>
                <TextBlock Text="{DynamicResource LOCPlayAch_Provider_ReXGlue}" Style="{StaticResource ProviderTitleTextStyle}"/>
            </StackPanel>
            <Border Style="{StaticResource ProviderEnableToggleBorderStyle}" Grid.IsSharedSizeScope="True">
                <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_ProviderEnabled}" FontWeight="SemiBold" Margin="0">
                    <CheckBox IsChecked="{Binding Settings.IsEnabled, Mode=TwoWay}"/>
                </controls:SettingRow>
            </Border>
            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ProviderDisabledMessage}"
                       Style="{StaticResource ProviderDisabledMessageStyle}"/>
            <Border Style="{StaticResource SectionBorderStyle}" IsEnabled="{Binding Settings.IsEnabled}">
                <StackPanel>
                    <TextBlock x:Name="ConnectionLabel" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource LOCPlayAch_Settings_ReXGlue_DataLabel}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   VerticalAlignment="Top" TextWrapping="Wrap"
                                   Margin="{StaticResource PlayAch.Thickness.Top.Sm}"/>
                        <Border Grid.Column="1" Style="{StaticResource ProviderConfigStatusBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding AuthStatus, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ReXGlue_UserFolder}"
                                           Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                                <Grid Margin="0,8,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="UserRootBox" Grid.Column="0" Margin="0,0,8,0"
                                             Text="{Binding Settings.UserDataRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="Path_TextChanged"/>
                                    <Button Grid.Column="1"
                                            Content="{DynamicResource LOCPlayAch_Button_Browse}"
                                            Click="BrowseUserRoot_Click"/>
                                </Grid>
                                <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ReXGlue_Description}"
                                           Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="{DynamicResource LOCPlayAch_Local_MetadataSettings}" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}"/>
        </StackPanel>
    </ScrollViewer>
</settings:ProviderSettingsViewBase>
