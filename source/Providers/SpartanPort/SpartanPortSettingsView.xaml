<settings:ProviderSettingsViewBase x:Class="PlayniteAchievements.Providers.SpartanPort.SpartanPortSettingsView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:settings="clr-namespace:PlayniteAchievements.Providers.Settings"
            xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
            mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Providers/ProviderSettingsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <StackPanel Style="{StaticResource ProviderHeaderPanelStyle}">
                <Viewbox Style="{StaticResource ProviderHeaderIconStyle}">
                    <Path Data="{StaticResource GeoSpartanPort}" Fill="#356CCB"/>
                </Viewbox>
                <TextBlock Text="{DynamicResource LOCPlayAch_Provider_SpartanPort}" Style="{StaticResource ProviderTitleTextStyle}"/>
            </StackPanel>
            <Border Style="{StaticResource ProviderEnableToggleBorderStyle}" Grid.IsSharedSizeScope="True">
                <controls:SettingRow Label="{DynamicResource LOCPlayAch_Settings_ProviderEnabled}" FontWeight="SemiBold" Margin="0">
                    <CheckBox IsChecked="{Binding Settings.IsEnabled, Mode=TwoWay}"/>
                </controls:SettingRow>
            </Border>
            <TextBlock Text="{DynamicResource LOCPlayAch_Settings_ProviderDisabledMessage}" Style="{StaticResource ProviderDisabledMessageStyle}"/>
            <Border Style="{StaticResource SectionBorderStyle}" IsEnabled="{Binding Settings.IsEnabled}">
                <StackPanel>
                    <TextBlock x:Name="ConnectionLabel" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource LOCPlayAch_Settings_SpartanPort_PathLabel}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}" VerticalAlignment="Top"
                                   TextWrapping="Wrap" Margin="{StaticResource PlayAch.Thickness.Top.Sm}"/>
                        <Border Grid.Column="1" Style="{StaticResource ProviderConfigStatusBorderStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource ProviderConfigStatusIconStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AuthStatus, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Grid>
                                <Border BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_SpartanPort_GameFolder}"
                                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                                        <Grid Margin="0,8,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="GameRootBox" Grid.Column="0" Margin="0,0,8,0"
                                                     Text="{Binding Settings.GameRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="Path_TextChanged"/>
                                            <Button Grid.Column="1" Content="{DynamicResource LOCPlayAch_Settings_SpartanPort_Browse}"
                                                    Click="BrowseRoot_Click"/>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_SpartanPort_SaveFolder}"
                                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                                        <Grid Margin="0,8,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="SaveFolderBox" Grid.Column="0" Margin="0,0,8,0"
                                                     Text="{Binding Settings.UserDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="Path_TextChanged"/>
                                            <Button Grid.Column="1" Content="{DynamicResource LOCPlayAch_Settings_SpartanPort_Browse}"
                                                    Click="BrowseSaves_Click"/>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource LOCPlayAch_Settings_SpartanPort_Description}"
                                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="{DynamicResource LOCPlayAch_Local_MetadataSettings}" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}"/>
        </StackPanel>
    </ScrollViewer>
</settings:ProviderSettingsViewBase>
