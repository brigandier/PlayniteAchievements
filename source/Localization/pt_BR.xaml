    <!-- Provider: RetroAchievements -->
    <sys:String x:Key="LOCPlayAch_Settings_RaUsername">Nome de usuário</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_RaWebApiKey">Chave da API Web</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_RaWebApiKey_Help">Encontre sua chave no painel de controle do RetroAchievements:</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_RaPointsMode">Exibição dos pontos</sys:String>
    <sys:String x:Key="LOCPlayAch_Settings_RaPointsMode_Description">O TrueRatio pondera os pontos pela raridade, valorizando conquistas mais difíceis.</sys:String>
